Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Here", " ", "I", " ", "define", " ", "the", " ", "two", " ", "non"}], "-", 
    RowBox[{
    "trivial", " ", "functions", " ", "out", " ", "of", " ", "the", " ", 
     "three", " ", "calculated", " ", "directly", " ", "above"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Note", " ", "that", " ", "I", " ", "have", " ", "simplified", " ", "the", 
    " ", "expressions"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"L1", "[", "r_", "]"}], ":=", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Cos", "[", "r", "]"}], "2"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"Cos", "[", "r", "]"}], "2"], "2"]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"L2", "[", "r_", "]"}], ":=", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"Sin", "[", "r", "]"}], "2"], "2"], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "r", "]"}], "2"]}], ")"}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9793246172797327`*^9, 3.979324647075861*^9}, {
