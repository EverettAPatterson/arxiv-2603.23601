41214f132bfa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Bipartite", " ", "entanglement"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"BE1res", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rs", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"EntanglementEntropy", "[", 
          RowBox[{"Rho", ",", 
           RowBox[{"rs", "[", 
