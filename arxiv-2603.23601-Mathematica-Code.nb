Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Function", " ", "for", " ", "L2"}], "-", 
    RowBox[{"norm", " ", "of", " ", "coherence"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "s", " ", "is", " ", "the", " ", "system", " ", "that", " ", "is", " ", 
     "traced", " ", "out"}], ",", " ", 
    RowBox[{"either", " ", "1", " ", "or", " ", "2"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L2CoherenceR", "[", 
     RowBox[{"\[Rho]_", ",", "rr_", ",", "s_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Rho]R", ",", "\[Rho]PT", ",", "\[Rho]Flat", ",", "LC"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]R", "=", 
        RowBox[{"\[Rho]", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{"r", "->", "rr"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Rho]PT", "=", 
        RowBox[{"TraceSystem", "[", 
         RowBox[{"\[Rho]R", ",", 
          RowBox[{"{", "s", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Rho]Flat", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"UpperTriangularize", "[", 
           RowBox[{"\[Rho]PT", ",", "1"}], "]"}], "+", 
          RowBox[{"LowerTriangularize", "[", 
           RowBox[{"\[Rho]PT", ",", 
            RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"LC", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"Abs", "[", 
            RowBox[{"\[Rho]Flat", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "2"], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "\[Rho]Flat", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "LC", "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9785348703008842`*^9, 3.978534890541485*^9}, {
  3.9785349829671507`*^9, 3.978535110349749*^9}, {3.978535328819229*^9, 
