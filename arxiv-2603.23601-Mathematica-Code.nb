       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "rs", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"BE2res", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
